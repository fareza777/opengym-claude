# Copy to keystore.properties (gitignored) and fill in with YOUR OWN key.
#
# Generate one with:
#
#   keytool -genkeypair -v -keystore tempa-upload.jks -alias tempa \
#           -keyalg RSA -keysize 4096 -validity 10000
#
# Then BACK THE .jks FILE UP somewhere you will still have in five years, along
# with both passwords. If you lose it you can never publish an update to the
# Play listing again — the package name is bound to the key. Enrol in Play App
# Signing when you first upload, which at least lets Google re-issue the app
# signing key if the upload key is lost.
#
# Never commit this file, the keystore, or the passwords. CI should pass the
# same four values as TEMPA_KEYSTORE / TEMPA_KEYSTORE_PASSWORD /
# TEMPA_KEY_ALIAS / TEMPA_KEY_PASSWORD instead.

storeFile=/absolute/path/to/tempa-upload.jks
storePassword=
keyAlias=tempa
keyPassword=
